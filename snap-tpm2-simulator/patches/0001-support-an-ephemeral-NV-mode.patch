From 35e2a66ec6a0c198c7bb11cd126b8e6c1bd77953 Mon Sep 17 00:00:00 2001
From: Chris Coulson <chris.coulson@canonical.com>
Date: Fri, 21 Oct 2022 21:54:03 +0100
Subject: [PATCH 1/3] support an ephemeral NV mode

---
 TPMCmd/Platform/include/PlatformData.h |  1 +
 TPMCmd/Platform/src/NVMem.c            | 13 +++++++++++--
 TPMCmd/Simulator/src/TPMCmds.c         |  8 ++++++++
 3 files changed, 20 insertions(+), 2 deletions(-)

diff --git a/TPMCmd/Platform/include/PlatformData.h b/TPMCmd/Platform/include/PlatformData.h
index 279c8e1..696d7a1 100644
--- a/TPMCmd/Platform/include/PlatformData.h
+++ b/TPMCmd/Platform/include/PlatformData.h
@@ -74,6 +74,7 @@ EXTERN unsigned char s_NV[NV_MEMORY_SIZE];
 EXTERN int           s_NvIsAvailable;
 EXTERN int           s_NV_unrecoverable;
 EXTERN int           s_NV_recoverable;
+EXTERN int           s_NV_ephemeral;
 
 // For PPPlat.c
 // Physical presence.  It is initialized to FALSE
diff --git a/TPMCmd/Platform/src/NVMem.c b/TPMCmd/Platform/src/NVMem.c
index b02f316..7f67b58 100644
--- a/TPMCmd/Platform/src/NVMem.c
+++ b/TPMCmd/Platform/src/NVMem.c
@@ -134,9 +134,16 @@ LIB_EXPORT int _plat__NVEnable(
 #if FILE_BACKED_NV
     if(s_NvFile != NULL)
         return NV_ENABLE_SUCCESS;
+
     // Initialize all the bytes in the ram copy of the NV
     _plat__NvMemoryClear(0, NV_MEMORY_SIZE);
 
+    if(s_NV_ephemeral)
+    {
+        s_NvIsAvailable = TRUE;
+        return NV_ENABLE_SUCCESS;
+    }
+
     // If the file exists
     if(NvFileOpen("r+b") >= 0)
     {
@@ -221,14 +228,14 @@ LIB_EXPORT int _plat__GetNvReadyState(void)
         retVal = NV_WRITEFAILURE;
 #if FILE_BACKED_NV
     else
-        retVal = (s_NvFile == NULL);
+        retVal = (!s_NV_ephemeral && s_NvFile == NULL);
 #endif
     return retVal;
 }
 
 //***_plat__NvMemoryRead()
 // Function: Read a chunk of NV memory
-//  Return Type: int
+//  Return TxxXXype: int
 //      TRUE(1)         offset and size is within available NV size
 //      FALSE(0)        otherwise; also trigger failure mode
 LIB_EXPORT int _plat__NvMemoryRead(unsigned int startOffset,  // IN: read start
@@ -337,6 +344,8 @@ LIB_EXPORT int _plat__NvMemoryMove(unsigned int sourceOffset,  // IN: source off
 LIB_EXPORT int _plat__NvCommit(void)
 {
 #if FILE_BACKED_NV
+    if(s_NV_ephemeral)
+        return 0;
     return (NvFileCommit() ? 0 : 1);
 #else
     return 0;
diff --git a/TPMCmd/Simulator/src/TPMCmds.c b/TPMCmd/Simulator/src/TPMCmds.c
index be51992..0b2edeb 100644
--- a/TPMCmd/Simulator/src/TPMCmds.c
+++ b/TPMCmd/Simulator/src/TPMCmds.c
@@ -4,6 +4,7 @@
 //** Includes, Defines, Data Definitions, and Function Prototypes
 #include "simulatorPrivate.h"
 #include <CryptoInterface.h>
+#include <Platform.h>
 
 #define PURPOSE                                                                 \
     "TPM 2.0 Reference Simulator.\n"                                            \
@@ -51,6 +52,8 @@ static void Usage(const char* programName)
             "   -h (--help) or ? - print this message\n"
             "   -m (--manufacture) - forces NV state of the TPM simulator to be "
             "(re)manufactured\n"
+            "   -e (--ephemeral) - store the NV state of the TPM simulator in "
+            "memory only (implies -m)\n"
             "   -p (--pick_ports) - choose the next available TCP ports "
             "automatically "
             "if PortNum is not available\n",
@@ -197,6 +200,11 @@ int main(int argc, char* argv[])
         {
             manufacture = true;
         }
+        if (CmdLineParser_IsOptPresent("ephemeral", "e"))
+        {
+            manufacture = true;
+            s_NV_ephemeral = 1;
+        }
         if(CmdLineParser_IsOptPresent("pick_ports", "p"))
         {
             pick_ports = true;
-- 
2.53.0

